rules_version = '2';

// ポイント・電子マネー期限管理アプリ
// MVPは個人利用のみ(共有機能なし)を前提とした匿名認証ベースのルール。
// たべゴロっとチェックと同様、Firebase Anonymous Auth の UID を ownerId として利用する。
//
// 注意: Firebase プロジェクト okizukibiyori は姉妹アプリと共用のため、
// このファイルだけを firebase deploy すると他アプリのルールが消える。
// firebase.json からは外してあるので、変更はルール全体を管理している側で反映すること。

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // 更新時に ownerId を書き換えられない(=有料化のレコード数集計がずれない)ようにする
    function ownerIdUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    // --- users/{uid} ---------------------------------------------------
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // --- accounts/{accountId} ------------------------------------------
    match /accounts/{accountId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId) && ownerIdUnchanged();
      allow create: if isOwner(request.resource.data.ownerId);

      // --- accounts/{accountId}/updates/{updateId} ----------------------
      match /updates/{updateId} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/accounts/$(accountId)).data.ownerId);
      }
    }

    // --- outcome_events/{eventId} ---------------------------------------
    match /outcome_events/{eventId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId) && ownerIdUnchanged();
      allow create: if isOwner(request.resource.data.ownerId);
    }

    // --- usage_counts_tamari/{uid}_{日本時間の日付} ------------------------
    // AI読み取りの1日あたりの利用回数。数えるのはサーバー側(Admin SDKはこのルールを
    // 経由しない)だけで、画面からは誰も書き込めない。読めるのは、中に記録された
    // uidが自分と一致する1件だけ。一覧は誰も読めない。
    // (姉妹アプリの usage_counts_mamori / usage_counts_tabe と重ならないよう名前を分けている)
    match /usage_counts_tamari/{docId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list, write: if false;
    }
  }
}
